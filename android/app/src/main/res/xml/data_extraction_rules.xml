<?xml version="1.0" encoding="utf-8"?>
<!-- Data extraction rules (API >= 31): same exclusions as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/screw_out.db" />
        <exclude domain="root" path="app_flutter/screw_out.db-wal" />
        <exclude domain="root" path="app_flutter/screw_out.db-shm" />
        <exclude domain="root" path="app_flutter/screw_out.db-journal" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/screw_out.db" />
        <exclude domain="root" path="app_flutter/screw_out.db-wal" />
        <exclude domain="root" path="app_flutter/screw_out.db-shm" />
        <exclude domain="root" path="app_flutter/screw_out.db-journal" />
        <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
